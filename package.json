{
  "name": "fibis-backend",
  "version": "1.0.0",
  "description": "Backend per il sistema FIBiS - Federazione Italiana Biliardo Sportivo",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node --import ./instrument.js server.js",
    "dev": "nodemon --import ./instrument.js server.js",
    "scrape-ranking": "node src/workers/rankingScraper.js",
    "scrape-gare": "node src/workers/gareScraper.js",
    "scrape-risultati": "node src/workers/risultatiScraper.js",
    "cron": "node src/workers/cron.js",
    "iscrizione": "node src/workers/iscrizioneWorker.js"
  },
  "keywords": [
    "fibis",
    "biliardo",
    "manutenzione",
    "ranking",
    "tesserati"
  ],
  "author": "FIBiS",
  "license": "ISC",
  "dependencies": {
    "@sentry/node": "^11.3.0",
    "@sentry/profiling-node": "^11.3.0",
    "@supabase/supabase-js": "^2.110.2",
    "bcryptjs": "^3.0.3",
    "cheerio": "^1.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "firebase-admin": "^14.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "node-cron": "^3.0.3",
    "otpauth": "^9.5.1",
    "pdfkit": "^0.20.2",
    "puppeteer": "^23.0.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
